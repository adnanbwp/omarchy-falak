#!/usr/bin/env bash
# Stand-in shell IPC: Do Not Disturb in $FALAK_TEST_DIR/dnd (or $FALAK_TEST_DND for alerts).
f="${FALAK_TEST_DIR:-/nonexistent}/dnd"
case "$*" in
  *isDnd*|*dndState*) [[ -f $f ]] && cat "$f" || echo "${FALAK_TEST_DND:-off}" ;;
  *"setDnd on"*) echo on > "$f"; echo on ;;
  *"setDnd off"*) echo off > "$f"; echo off ;;
esac

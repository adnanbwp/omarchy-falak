#!/usr/bin/env python3
"""Build plugin/assets/cities.json from GeoNames cities15000 (CC-BY 4.0).

    dev/build-cities <dir with cities15000.txt, admin1CodesASCII.txt, countryInfo.txt>

Fetch those from https://download.geonames.org/export/dump/ first. Rows are
[name, region, country code, lat, lon, zone index, aliases...] (zone index
into "zones", the IANA timezone names), biggest cities first, so a
prefix search shows the likely one at the top. Cities over 500k keep a few
alternate names (Mecca for Makkah) and their Arabic-script names (مكة).
"""
import json, os, sys

src = sys.argv[1]
here = os.path.dirname(os.path.abspath(__file__))

admin1 = {}
for line in open(os.path.join(src, "admin1CodesASCII.txt"), encoding="utf8"):
    code, name = line.split("\t")[:2]
    admin1[code] = name

countries = {}
for line in open(os.path.join(src, "countryInfo.txt"), encoding="utf8"):
    if line.startswith("#"):
        continue
    f = line.split("\t")
    countries[f[0]] = f[4]

rows, zones, zone_index = [], [], {}
for line in open(os.path.join(src, "cities15000.txt"), encoding="utf8"):
    f = line.rstrip("\n").split("\t")
    name, ascii_name, lat, lon, cc, a1, pop = f[1], f[2], float(f[4]), float(f[5]), f[8], f[10], int(f[14] or 0)
    tz = f[17]
    if tz not in zone_index:
        zone_index[tz] = len(zones); zones.append(tz)
    aliases = [ascii_name] if ascii_name != name else []
    if pop >= 500000:
        alts = [a for a in f[3].split(",") if a and a not in (name, ascii_name)]
        seen, latin = {name.lower(), ascii_name.lower()}, []
        for a in alts:
            if a.isascii() and 3 < len(a) <= 14 and a[0].isupper() and not a.isupper() and a.lower() not in seen:
                seen.add(a.lower()); latin.append(a)
        latin = latin[:16]
        arabic = [a for a in alts if any("\u0600" <= ch <= "\u06ff" for ch in a)][:5]
        aliases += latin + arabic
    rows.append((pop, [name, admin1.get(cc + "." + a1, ""), cc, round(lat, 3), round(lon, 3), zone_index[tz]] + aliases))
rows.sort(key=lambda r: -r[0])

out = os.path.join(here, "..", "assets")
os.makedirs(out, exist_ok=True)
with open(os.path.join(out, "cities.json"), "w", encoding="utf8") as fh:
    json.dump({"countries": countries, "zones": zones, "cities": [r[1] for r in rows]}, fh, ensure_ascii=False, separators=(",", ":"))
print(len(rows), "cities")

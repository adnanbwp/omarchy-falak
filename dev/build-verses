#!/usr/bin/env python3
"""Build plugin/assets/verses.json: verses on the sky, time, light and prayer,
fetched by reference (never typed) from api.alquran.cloud, which serves the
Tanzil Quran text (quran-simple) and Pickthall's 1930 translation (public domain).

    dev/build-verses

Rows: [reference, surah name, Arabic, English]. Prints every row to check.
"""
import json, os, time, urllib.request

REFS = """2:144 2:164 2:189 2:238 3:190 6:96 6:97 7:54 10:5 10:6 11:114 13:2 14:33 16:12 16:16
17:12 17:78 20:130 21:33 24:35 25:61 25:62 30:17 30:18 31:29 35:13 36:37 36:38 36:39 36:40
39:5 41:37 50:39 51:47 55:5 55:17 67:3 67:5 71:16 78:10 78:11 78:13 86:1 89:1 89:2 91:1
91:2 92:1 92:2 93:1 93:2 97:5 103:1 113:1""".split()

rows = []
for ref in REFS:
    url = "https://api.alquran.cloud/v1/ayah/%s/editions/quran-simple,en.pickthall" % ref
    req = urllib.request.Request(url, headers={"User-Agent": "Falak-plugin-build/1.0"})
    data = json.load(urllib.request.urlopen(req, timeout=30))["data"]
    ar, en = data[0], data[1]
    text = ar["text"]
    # The first verse of a surah carries the basmala in this edition; it is not part of the verse.
    # Matched by its first word and stripped as four words: the edition's exact
    # Unicode for the basmala need not equal a typed one.
    if ar["numberInSurah"] == 1 and ar["surah"]["number"] != 1 and text.startswith("بِسْمِ"):
        text = " ".join(text.split()[4:])
    # ۞ marks a section of the recitation, not a word of the verse.
    text = text.lstrip("۞ ").strip()
    rows.append([ref, ar["surah"]["englishName"], text, en["text"]])
    print(ref, "|", text, "|", en["text"])
    time.sleep(0.3)

out = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "assets", "verses.json")
json.dump(rows, open(out, "w", encoding="utf8"), ensure_ascii=False, separators=(",", ":"))
print(len(rows), "verses")
